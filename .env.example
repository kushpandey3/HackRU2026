# Tiger Cloud Postgres connection string (recommended for shared / deployed accounts).
# Set sslmode=require if it is not already included in your Tiger connection string.
DATABASE_URL=YOUR_DATABASE_URL
# Optional for local use; if omitted, the app saves a generated key in instance/secret_key.
# For deployment, set a private, stable SECRET_KEY in the hosting environment.
# SECRET_KEY=replace-with-a-long-random-secret
# Optional settings
INITIAL_CASH=100000
PORT=5000
# FLASK_DEBUG=1
