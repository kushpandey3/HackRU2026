# Tiger Cloud Postgres connection string (recommended for shared / deployed accounts).
# Set sslmode=require if it is not already included in your Tiger connection string.
DATABASE_URL=YOUR_DATABASE_URL

# Optional settings
INITIAL_CASH=100000
PORT=5000
# FLASK_DEBUG=1

# Leave DATABASE_URL blank to use a local SQLite file for a quick preview.
# SQLITE_PATH=paper_trading.db
